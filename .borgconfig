[submodule "dash"]
	no-byte-compile = dash-functional.el
	no-makeinfo = dash-template.texi
[submodule "emacsql"]
	no-byte-compile = emacsql-pg.el
	build-step = make
	build-step = borg-update-autoloads
	load-path = .
[submodule "transient"]
	load-path = lisp
	build-step = make
[submodule "magit"]
	no-byte-compile = lisp/magit-libgit.el
[submodule "sqlite3"]
	build-step = make
	build-step = borg-update-autoloads
[submodule "vertico"]
	load-path = .
	load-path = extensions
[submodule "corfu"]
	load-path = .
	load-path = extensions
[submodule "lsp-bridge"]
	load-path = .
	load-path = acm
	build-step = borg-update-autoloads
[submodule "lsp-mode"]
	load-path = .
	load-path = clients
	load-path = features/step-definitions
	load-path = features/support
	load-path = scripts
	load-path = use-package
[submodule "doom-themes"]
	load-path = .
	load-path = themes
	load-path = extensions
[submodule "tree-sitter"]
	load-path = lisp
	load-path = core
	# Don't run `make build' (bin/build): its `cp -f' truncates
	# core/tsc-dyn.so in place, corrupting the mapping when the module
	# is already loaded by the batch Emacs (SIGSEGV at exit, err 139).
	# The Rust module only needs rebuilding after the submodule is
	# updated; do that manually with `make -C lib/tree-sitter build'
	# (or `bin/build') while no Emacs has tsc-dyn loaded.
	build-step = borg-update-autoloads
	build-step = borg-compile
[submodule "liberime"]
	build-step = EMACS_MAJOR_VERSION=29 make
	build-step = cp src/liberime-core.so .
	build-step = borg-update-autoloads
[submodule "dirvish"]
	load-path = .
	load-path = extensions
[submodule "pyim"]
	no-byte-compile = pyim-liberime.el
[submodule "vterm"]
	build-step = "mkdir -p build;cd build;cmake -G 'Unix Makefiles' ..;make"
	build-step = borg-compile
	build-step = borg-update-autoloads
[submodule "wgrep"]
	no-byte-compile = wgrep-subtest.el
[submodule "forge"]
	build-step = borg-update-autoloads
[submodule "ai-code-interface"]
	load-path = .
	load-path = etc
